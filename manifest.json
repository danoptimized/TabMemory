{
  "manifest_version": 3,
  "name": "Tab Memory",
  "version": "1.2",
  "description": "Lists open tabs by memory use, biggest first. Auto-sleeps idle background tabs.",
  "permissions": ["tabs", "scripting", "processes", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Tab Memory" }
}
